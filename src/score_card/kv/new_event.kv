<NewEventScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(16)
        md_bg_color: self.theme_cls.bg_color

        MDLabel:
            text: "New Event"
            font_style: "H4"
            halign: "center"
            size_hint_y: None
            height: dp(70)
            theme_text_color: "Primary"

        MDTextField:
            id: name_input
            hint_text: "Event name *"
            size_hint_y: None
            height: dp(48)

        MDButton:
            id: date_button
            text: root.selected_date if root.selected_date else "Select Date"
            size_hint_x: 1
            size_hint_y: None
            height: dp(52)
            on_release: root.show_date_picker()

        MDTextField:
            id: location_input
            hint_text: "Location"
            size_hint_y: None
            height: dp(48)

        MDTextField:
            id: notes_input
            hint_text: "Notes"
            size_hint_y: None
            height: dp(110)
            multiline: True

        MDLabel:
            text: root.status_message if hasattr(root, 'status_message') else ""
            size_hint_y: None
            height: dp(30)
            halign: "center"
            theme_text_color: "Custom"
            text_color: 0.3, 0.9, 0.3, 1

        Widget:
            size_hint_y: 1

        MDButton:
            text: "Save Event"
            size_hint_x: 1
            size_hint_y: None
            height: dp(54)
            on_release: root.save_event()

        MDButton:
            text: "Cancel"
            size_hint_x: 1
            size_hint_y: None
            height: dp(54)
            on_release: root.go_back()
